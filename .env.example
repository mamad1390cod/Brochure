[TEMPLATE]
# ============================================
# Bot-File-School Configuration
# Copy this file to .env and fill in values
# ============================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Main Admin Telegram ID (numeric)
MAIN_ADMIN_ID=123456789

# Allowed Group Chat ID (leave empty to disable group restriction)
ALLOWED_GROUP_ID=-1001234567890

# Admin Panel Password (will be hashed on first run)
ADMIN_PASSWORD=change_this_password

# Database path
DATABASE_PATH=data/school_notes.db

# Bot username (without @)
BOT_USERNAME=BotFileSchoolBot

# ── Optional standalone PDF bot (bot1cc.py) ─────────────────
# Full path to the existing PDF bot script. It is launched
# automatically as a separate process when the main bot starts.
# Leave empty to skip it (the in-app PDF tools still work).
# On your other machine, for example:
#   PDF_BOT_PATH=I:\python\botha\BOT1\bot1cc.py
PDF_BOT_PATH=

# Public username (without @) of the standalone PDF bot for the
# handoff link shown in the "📄 ساخت PDF" menu. Leave empty if N/A.
PDF_BOT_USERNAME=

# ── Security settings ───────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ENABLE_INLINE_SEARCH=true
INLINE_SEARCH_ALLOWED_USERS=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
